# ==============================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como '.env' en tu servidor VPS y configura
# tus contraseñas y valores reales. NUNCA subas el archivo '.env' a Git.
# ==============================================================

# Configuración de Base de Datos MySQL
DB_HOST=db
DB_USER=root
DB_PASSWORD=coloca_aqui_una_contrasena_segura_para_mysql
DB_NAME=bdchifon
DB_PORT=3306

# Configuración de Puertos
BACKEND_PORT=3001
FRONTEND_PORT=80

# Seguridad JWT (clave secreta para firmar tokens)
JWT_SECRET=coloca_aqui_una_clave_jwt_larga_y_segura_aleatoria

